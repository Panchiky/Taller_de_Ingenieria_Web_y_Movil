# Variables de entorno para las pruebas automatizadas (npm test).
# No son secretos reales: por eso este archivo SÍ se puede subir a GitHub.
NODE_ENV=test
JWT_SECRET=clave-solo-para-pruebas
JWT_EXPIRA=1h
GITHUB_CLIENT_ID=cliente-de-prueba
GITHUB_CLIENT_SECRET=secreto-de-prueba
GITHUB_REDIRECT_URI=http://localhost:8100/auth/github/callback
